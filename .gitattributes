# Auto detect text files and normalize line endings to LF
* text=auto

# C# files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf

# JSON files
*.json text eol=lf
*.jsonc text eol=lf

# XML files
*.xml text eol=lf
*.xaml text eol=lf

# Markdown files
*.md text eol=lf
*.markdown text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.o binary
*.a binary
*.lib binary

# Image files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Archive files
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Video files
*.mp4 binary
*.avi binary
*.mov binary
*.flv binary

# Audio files
*.mp3 binary
*.wav binary
*.aac binary

# Font files
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Database files
*.db binary
*.sqlite binary
*.mdf binary
*.ldf binary
